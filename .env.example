# Application Configuration
APP_NAME=BookstoreAgentBackend
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (Async SQLite default, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./bookstore.db

# Security & CORS
SECRET_KEY=change-this-in-production-to-a-secure-random-token
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# LLM / Agent Provider (e.g. mock, watsonx, openai, ollama)
AGENT_MODEL_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_NAME=granite-3-8b-instruct
